# Public Razorpay key is fetched from the backend at runtime. Do not put a
# Razorpay secret in any frontend environment file.
# Set this to your deployed backend base (include /api)
REACT_APP_API_URL=https://nouveau-dk1a.vercel.app/api
# Optional: If your backend serves uploads from a different base
REACT_APP_UPLOADS_BASE_URL=https://nouveau-dk1a.vercel.app
